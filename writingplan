        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function resetPlanner() {
            initApp();
            showToast("Planner reset to default.", "fa-rotate-right");
        }

        function showToast(msg, icon = 'fa-circle-info') {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            document.getElementById('toast-icon').className = `fa-solid ${icon} text-indigo-400`;

            toast.classList.remove('opacity-0', 'translate-y-5', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-5', 'pointer-events-none');
                toast.classList.remove('opacity-100', 'translate-y-0');
            }, 3000);
        }
    </script>
