        function openAITopicModal() {
            document.getElementById('modal-ai-generator').classList.remove('hidden');
        }

        function generateAIDSETopic() {
            const elective = document.getElementById('ai-elective-select').value;
            const keywords = document.getElementById('ai-custom-keywords').value.trim() || "Youth & Modern Society";
            const btn = document.getElementById('btn-run-ai-gen');
            const statusEl = document.getElementById('ai-loading-status');

            btn.disabled = true;
            btn.classList.add('opacity-50');
            statusEl.classList.remove('hidden');

            setTimeout(() => {
                const generatedTopic = createPresetOrAITopic(elective, keywords);
                
                topicsBank.unshift(generatedTopic);
                populateTopicDropdown();
                document.getElementById('topic-selector').value = generatedTopic.id;
                loadTopic(generatedTopic.id);

                btn.disabled = false;
                btn.classList.remove('opacity-50');
                statusEl.classList.add('hidden');
                closeModal('modal-ai-generator');
                showToast(`Generated: ${generatedTopic.title}`, "fa-wand-magic-sparkles");
            }, 800);
        }

        function createPresetOrAITopic(elective, keywords) {
            const timeId = Date.now();
            return {
                id: "ai-gen-" + timeId,
                tag: "AI Generated Practice",
                format: "Opinion Article & Proposal",
                elective: elective,
                words: "Target: 400–500 words",
                title: `${elective}: Tackling ${keywords}`,
                desc: `Write a comprehensive HKDSE English Paper 2 response analyzing the impact of <b>${keywords}</b> in Hong Kong society (<b>Part 1</b>), providing practical steps individuals or students can implement immediately (<b>Part 2</b>), and recommending long-term policies for community and government institutions (<b>Part 3</b>).`,
                cards: [
                    { id: "card-1", text: `Rapid developments in ${keywords} have fundamentally transformed daily routines for young people in Hong Kong.`, section: "part1", hierarchy: "umbrella" },
                    { id: "card-2", text: `Increasing reliance on online platforms leading to reduced face-to-face social interactions.`, section: "part1", hierarchy: "detail", parentId: "card-1" },
                    { id: "card-3", text: `High pressure to adapt quickly causing stress among students and parents alike.`, section: "part1", hierarchy: "detail", parentId: "card-1" },
                    { id: "card-4", text: `Individual students can adopt disciplined daily habits to build resilience and focus.`, section: "part2", hierarchy: "umbrella" },
                    { id: "card-5", text: `Setting designated screen-free periods during homework and dinner hours.`, section: "part2", hierarchy: "detail", parentId: "card-4" },
                    { id: "card-6", text: `Actively seeking out peer discussion groups to share experiences and coping techniques.`, section: "part2", hierarchy: "umbrella" },
                    { id: "card-7", text: "Organizing weekly study circles and wellness workshops on campus.", section: "part2", hierarchy: "detail", parentId: "card-6" },
                    { id: "card-8", text: "Maintaining physical wellness directly supports mental sharpness when facing modern challenges.", section: "part2", hierarchy: "umbrella" },
                    { id: "card-9", text: "Engaging in at least 30 minutes of aerobic exercise three times a week.", section: "part2", hierarchy: "detail", parentId: "card-8" },
