<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DSE Writing Mindmap & Structure Builder</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .card-selected {
            ring: 3px;
            ring-color: #6366f1;
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Navigation Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-md">
                    <i class="fa-solid fa-sitemap text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-slate-900 leading-tight">DSE Essay Mindmap & Paragraph Builder</h1>
                    <p class="text-xs text-slate-500">Master the 3-Part Structure & Paragraph Hierarchy</p>
                </div>
            </div>

            <!-- Header Buttons -->
            <div class="flex items-center gap-2 flex-wrap">
                <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl border border-slate-200">
                    <select id="topic-selector" onchange="switchTopic(this.value)" class="bg-white text-xs font-bold text-slate-700 py-1.5 px-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 max-w-[180px] sm:max-w-xs truncate">
                        <!-- Populated by JavaScript -->
                    </select>
                    <button onclick="loadRandomTopic()" title="Load Random DSE Topic" class="px-2.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg shadow transition flex items-center gap-1">
                        <i class="fa-solid fa-dice"></i>
                        <span class="hidden sm:inline">Next Topic</span>
                    </button>
                    <button onclick="openAITopicModal()" title="AI Generate Custom DSE Topic" class="px-2.5 py-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold rounded-lg shadow transition flex items-center gap-1">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        <span class="hidden sm:inline">AI Generator</span>
                    </button>
                </div>

                <button id="btn-toggle-view" onclick="toggleView()" class="px-3.5 py-2 text-xs font-semibold rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition flex items-center gap-2">
                    <i class="fa-solid fa-diagram-project text-indigo-600"></i>
                    <span id="view-toggle-text">Diagram Mindmap View</span>
                </button>
                <button onclick="openCustomizer()" class="px-3.5 py-2 text-xs font-semibold rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-amber-600"></i>
                    <span>Edit Prompt</span>
                </button>
                <button onclick="resetPlanner()" class="px-3.5 py-2 text-xs font-semibold rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition flex items-center gap-2">
                    <i class="fa-solid fa-rotate-right text-slate-500"></i>
                    <span>Reset</span>
                </button>
                <button onclick="checkAnswers()" class="px-4 py-2 text-xs font-bold rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white shadow-md transition flex items-center gap-2">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Check Solution</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Interactive Playground -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 flex flex-col gap-6">

        <!-- Essay Question Prompt Banner -->
        <div class="bg-slate-900 text-white rounded-2xl p-4 sm:p-5 shadow-md border border-slate-800 flex flex-col gap-2 relative">
            <div class="flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-2">
                    <span id="prompt-tag" class="bg-amber-400 text-slate-950 text-[10px] font-extrabold uppercase tracking-wide px-2.5 py-0.5 rounded-md">HKDSE Part B Task</span>
                    <span id="prompt-format" class="text-xs text-slate-300 font-semibold"><i class="fa-solid fa-file-pen text-indigo-400 mr-1.5"></i>School Blog Post</span>
                </div>
                <div class="flex items-center gap-3">
                    <span id="prompt-elective" class="text-[10px] bg-slate-800 text-indigo-300 px-2 py-0.5 rounded border border-indigo-500/30 font-semibold">Social Issues</span>
                    <span id="prompt-words" class="text-xs text-slate-400"><i class="fa-solid fa-clock text-amber-400 mr-1"></i>Target: 400–500 words</span>
                </div>
            </div>
            <div class="space-y-1">
                <h2 id="prompt-title" class="text-sm sm:text-base font-bold text-amber-300">Writing Question: Addressing High Exam Stress Among Students</h2>
                <p id="prompt-desc" class="text-xs text-slate-300 leading-relaxed">
                    You are the Student Editor of your school magazine. Write a blog post describing the current state of exam pressure among schoolmates (<b>Part 1</b>), discussing immediate ways students can deal with this stress (<b>Part 2</b>), and suggesting long-term solutions for the school to reduce systemic pressure (<b>Part 3</b>).
                </p>
            </div>
        </div>

        <!-- Top Guide / Status Banner -->
        <div class="bg-indigo-900 text-white rounded-2xl p-4 sm:p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="space-y-1">
                <span class="inline-block bg-indigo-500/30 text-indigo-200 text-[10px] font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-full border border-indigo-400/30">
                    Step-by-Step Pre-Writing Activity
                </span>
                <h2 class="text-base sm:text-lg font-bold">Classify & Establish Paragraph Hierarchy</h2>
                <p class="text-xs text-indigo-200 max-w-2xl">
                    1. Assign each card below to <b>Part 1</b>, <b>Part 2</b>, or <b>Part 3</b>.<br>
                    2. Tag each card as either an <b><span class="text-amber-300">Umbrella Point 🟠</span></b> (Topic Sentence) or a <b><span class="text-emerald-300">Supporting Detail 🔴</span></b> (Example/Elaboration).
                </p>
            </div>

            <!-- Progress Tracker -->
            <div class="flex items-center gap-4 bg-indigo-950/60 p-3 rounded-xl border border-indigo-700/50 self-stretch sm:self-auto justify-around">
                <div class="text-center">
                    <div id="stat-placed" class="text-xl font-extrabold text-amber-400">0 / 12</div>
                    <div class="text-[10px] text-indigo-300 uppercase tracking-wider font-medium">Placed</div>
                </div>
                <div class="h-8 w-[1px] bg-indigo-800"></div>
                <div class="text-center">
                    <div id="stat-hierarchy" class="text-xl font-extrabold text-emerald-400">0 / 12</div>
                    <div class="text-[10px] text-indigo-300 uppercase tracking-wider font-medium">Tagged</div>
                </div>
            </div>
        </div>

        <!-- Interactive Board: Card Pool vs Columns -->
        <div id="classification-view" class="grid grid-cols-1 lg:grid-cols-4 gap-6">

            <!-- Left Sidebar: Scrambled Pool -->
            <div class="lg:col-span-1 bg-white rounded-2xl border border-slate-200 shadow-sm p-4 flex flex-col h-[600px]">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-indigo-600"></i>
                        <h3 class="font-bold text-sm text-slate-800">Scrambled Pool</h3>
                    </div>
                    <span id="pool-count-badge" class="bg-indigo-100 text-indigo-700 text-xs font-bold px-2 py-0.5 rounded-full">12 Left</span>
                </div>
                <p class="text-[11px] text-slate-500 mb-3">Click a card to select it, then click any section on the right to place it.</p>
                
                <div id="pool-container" class="flex-1 overflow-y-auto custom-scrollbar space-y-2.5 pr-1">
                    <!-- Cards injected here via JavaScript -->
                </div>
            </div>

            <!-- Right Area: 3 Writing Sections -->
            <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-4">

                <!-- PART 1 COLUMN -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[600px] overflow-hidden">
                    <div class="bg-slate-900 text-white p-3.5 border-b border-slate-800">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Section 1</span>
                            <span id="p1-badge" class="text-[10px] bg-slate-800 px-2 py-0.5 rounded text-slate-300 font-bold">0 cards</span>
                        </div>
                        <h3 class="font-bold text-sm text-white">Part 1: Current Problem</h3>
                        <p class="text-[10px] text-slate-400">Describe exam stress state</p>
                    </div>

                    <div id="zone-part1" onclick="handleZoneClick('part1')" class="flex-1 p-3 bg-slate-50/50 overflow-y-auto custom-scrollbar space-y-3 transition border-2 border-dashed border-transparent hover:border-indigo-300 cursor-pointer">
                        <!-- Placed cards injected here -->
                    </div>
                </div>

                <!-- PART 2 COLUMN -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[600px] overflow-hidden">
                    <div class="bg-indigo-900 text-white p-3.5 border-b border-indigo-800">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-indigo-300">Section 2</span>
                            <span id="p2-badge" class="text-[10px] bg-indigo-950 px-2 py-0.5 rounded text-indigo-200 font-bold">0 cards</span>
                        </div>
                        <h3 class="font-bold text-sm text-white">Part 2: Immediate Ways</h3>
                        <p class="text-[10px] text-indigo-200">Actions for students/peers</p>
                    </div>

                    <div id="zone-part2" onclick="handleZoneClick('part2')" class="flex-1 p-3 bg-slate-50/50 overflow-y-auto custom-scrollbar space-y-3 transition border-2 border-dashed border-transparent hover:border-indigo-300 cursor-pointer">
                        <!-- Placed cards injected here -->
                    </div>
                </div>

                <!-- PART 3 COLUMN -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[600px] overflow-hidden">
                    <div class="bg-teal-900 text-white p-3.5 border-b border-teal-800">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-teal-300">Section 3</span>
                            <span id="p3-badge" class="text-[10px] bg-teal-950 px-2 py-0.5 rounded text-teal-200 font-bold">0 cards</span>
                        </div>
                        <h3 class="font-bold text-sm text-white">Part 3: Long-term Solutions</h3>
                        <p class="text-[10px] text-teal-200">School & systemic changes</p>
                    </div>

                    <div id="zone-part3" onclick="handleZoneClick('part3')" class="flex-1 p-3 bg-slate-50/50 overflow-y-auto custom-scrollbar space-y-3 transition border-2 border-dashed border-transparent hover:border-indigo-300 cursor-pointer">
                        <!-- Placed cards injected here -->
                    </div>
                </div>

            </div>
        </div>

        <!-- Alternate View: Visual Mindmap Diagram -->
        <div id="diagram-view" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex-col min-h-[600px] relative overflow-x-auto">
            <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
                <div>
                    <h3 class="font-bold text-slate-900 text-base">Visual Mindmap Blueprint</h3>
                    <p class="text-xs text-slate-500">Interactive hierarchical layout of your essay structure</p>
                </div>
                <div class="flex items-center gap-4 text-xs font-semibold">
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-400"></span> Umbrella Point (Topic Sentence)</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-400"></span> Supporting Detail (Elaboration/Example)</span>
                </div>
            </div>

            <div id="diagram-canvas" class="flex-1 flex flex-col justify-center items-center gap-8 py-6 min-w-[900px]">
                <!-- Interactive Mindmap rendered via JS -->
            </div>
        </div>

    </main>

    <!-- Modal: Feedback & Results -->
    <div id="modal-results" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 relative">
            <div class="text-center space-y-3">
                <div id="modal-icon-bg" class="w-14 h-14 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center mx-auto text-2xl">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <h3 id="modal-title" class="text-xl font-bold text-slate-900">Structure Evaluation</h3>
                <p id="modal-subtitle" class="text-xs text-slate-500">Here is how well your outline matches the recommended DSE blueprint.</p>
            </div>

            <div class="my-6 space-y-3">
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 flex justify-between items-center text-xs">
                    <span class="font-medium text-slate-700">Section Categorization:</span>
                    <span id="score-section" class="font-bold text-indigo-600 text-sm">0 / 12 Correct</span>
                </div>
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 flex justify-between items-center text-xs">
                    <span class="font-medium text-slate-700">Paragraph Hierarchy (Umbrella vs Detail):</span>
                    <span id="score-hierarchy" class="font-bold text-indigo-600 text-sm">0 / 12 Correct</span>
                </div>
                <div id="feedback-details" class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 leading-relaxed">
                    <!-- Specific feedback message -->
                </div>
            </div>

            <div class="flex gap-3">
                <button onclick="closeModal('modal-results')" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
                    Keep Editing
                </button>
                <button onclick="revealModelSolution()" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md transition">
                    Auto-Fix to Ideal Blueprint
                </button>
            </div>
        </div>
    </div>

    <!-- Modal: Teacher Prompt & Point Editor -->
    <div id="modal-customizer" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-100 relative max-h-[90vh] flex flex-col">
            <div class="flex justify-between items-center pb-3 border-b border-slate-100">
                <h3 class="text-base font-bold text-slate-900">Customizer: Edit Essay Topic & Cards</h3>
                <button onclick="closeModal('modal-customizer')" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <p class="text-xs text-slate-500 my-2">Use this to customize the points for any future HKDSE writing topic!</p>

            <div class="flex-1 overflow-y-auto custom-scrollbar space-y-4 py-2 pr-1" id="customizer-card-list">
                <!-- Editable list injected here -->
            </div>

            <div class="flex gap-2 pt-3 border-t border-slate-100 mt-2">
                <button onclick="closeModal('modal-customizer')" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
                    Cancel
                </button>
                <button onclick="saveCustomizations()" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow transition">
                    Save Changes
                </button>
            </div>
        </div>
    </div>

    <!-- Modal: AI DSE Topic Generator -->
    <div id="modal-ai-generator" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 relative">
            <div class="flex justify-between items-center pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <div class="p-2 bg-amber-100 text-amber-700 rounded-xl">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-900">AI DSE Topic Generator</h3>
                        <p class="text-[11px] text-slate-500">Generates complete 3-part essay tasks & 12 cards</p>
                    </div>
                </div>
                <button onclick="closeModal('modal-ai-generator')" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="my-4 space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Select HKDSE Elective Theme:</label>
                    <select id="ai-elective-select" class="w-full text-xs p-2.5 rounded-xl border border-slate-300 bg-slate-50 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="Social Issues">Learning English through Social Issues</option>
                        <option value="Technology & Workplace">Learning English through Workplace Communication & Tech</option>
                        <option value="Sports & Health">Learning English through Sports Communication</option>
                        <option value="Debating & Community">Learning English through Debating & Public Speaking</option>
                        <option value="Short Stories & Culture">Learning English through Popular Culture / Arts</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Custom Focus / Topic (Optional):</label>
                    <input type="text" id="ai-custom-keywords" placeholder="e.g. AI homework tools, youth mental health, tourism" class="w-full text-xs p-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div id="ai-loading-status" class="hidden p-3 bg-indigo-50 border border-indigo-200 rounded-xl flex items-center gap-3">
                    <i class="fa-solid fa-spinner fa-spin text-indigo-600 text-lg"></i>
                    <div class="text-xs text-indigo-900 font-semibold">
                        Generating new DSE writing task & 12 structured cards...
                    </div>
                </div>
            </div>

            <div class="flex gap-2 pt-2 border-t border-slate-100">
                <button onclick="closeModal('modal-ai-generator')" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
                    Cancel
                </button>
                <button id="btn-run-ai-gen" onclick="generateAIDSETopic()" class="flex-1 py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold rounded-xl shadow-md transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-bolt"></i>
                    <span>Generate Practice</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Message Toast Container -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white text-xs px-4 py-3 rounded-xl shadow-2xl transition-all opacity-0 translate-y-5 pointer-events-none z-50 flex items-center gap-2">
        <i id="toast-icon" class="fa-solid fa-circle-info text-indigo-400"></i>
        <span id="toast-msg">Notification</span>
    </div>

    <script>
        const topicsBank = [
            {
                id: "dse-2023-stress",
                tag: "HKDSE Paper 2 Inspired",
                format: "School Blog Post",
                elective: "Social Issues",
                words: "Target: 400–500 words",
                title: "Addressing High Exam Stress & Well-being Among Students",
                desc: "Write a blog post describing the current state of exam pressure among schoolmates (Part 1), discussing immediate ways students can deal with this stress (Part 2), and suggesting long-term solutions for the school to reduce systemic pressure (Part 3).",
                cards: [
                    { id: "card-1", text: "Students face overwhelming anxiety as major examinations draw near.", section: "part1", hierarchy: "umbrella" },
                    { id: "card-2", text: "Reading textbooks frantically during recess instead of relaxing.", section: "part1", hierarchy: "detail", parentId: "card-1" },
                    { id: "card-3", text: "Constantly comparing test marks with classmates and feeling inferior.", section: "part1", hierarchy: "detail", parentId: "card-1" },
                    { id: "card-4", text: "Engaging in regular active rest helps lower cortisol levels and refresh the mind.", section: "part2", hierarchy: "umbrella" },
                    { id: "card-5", text: "Playing 30 minutes of basketball, running, or swimming daily.", section: "part2", hierarchy: "detail", parentId: "card-4" },
                    { id: "card-6", text: "Forming peer support groups allows students to share emotional and study burdens.", section: "part2", hierarchy: "umbrella" },
                    { id: "card-7", text: "Studying together, sharing family issues, and exchanging learning strategies.", section: "part2", hierarchy: "detail", parentId: "card-6" },
                    { id: "card-8", text: "While some argue sacrificing sleep yields higher marks, sleep loss destroys memory.", section: "part2", hierarchy: "umbrella" },
                    { id: "card-9", text: "Severe sleep deprivation leaves students exhausted on exam day.", section: "part2", hierarchy: "detail", parentId: "card-8" },
                    { id: "card-10", text: "School management must implement policies to lighten student workload.", section: "part3", hierarchy: "umbrella" },
                    { id: "card-11", text: "Teachers reducing homework and temporarily suspending extracurriculars before exams.", section: "part3", hierarchy: "detail", parentId: "card-10" },
                    { id: "card-12", text: "Establishing healthy biological routines to maintain long-term mental well-being.", section: "part3", hierarchy: "detail", parentId: "card-10" }
                ]
            },
            {
                id: "dse-2022-fastfashion",
                tag: "HKDSE Social Issues",
                format: "Letter to the Editor",
                elective: "Social Issues & Environment",
                words: "Target: 400–500 words",
                title: "Tackling the Fast Fashion Waste Crisis in Hong Kong",
                desc: "Write a letter to the editor describing the environmental impact of fast fashion among youth (Part 1), proposing sustainable habits students can adopt (Part 2), and suggesting government and industry measures to tackle clothing waste (Part 3).",
                cards: [
                    { id: "card-1", text: "Cheap trendy clothing leads teenagers to buy excessively and discard clothes quickly.", section: "part1", hierarchy: "umbrella" },
                    { id: "card-2", text: "Overflowing local landfills with tons of synthetic non-biodegradable fabrics.", section: "part1", hierarchy: "detail", parentId: "card-1" },
                    { id: "card-3", text: "Harmful chemical dyes polluting rivers in manufacturing countries.", section: "part1", hierarchy: "detail", parentId: "card-1" },
                    { id: "card-4", text: "Young consumers can adopt sustainable wardrobe practices to curb demand.", section: "part2", hierarchy: "umbrella" },
