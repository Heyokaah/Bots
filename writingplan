        let currentTopicId = topicsBank[0].id;
        let cardsData = JSON.parse(JSON.stringify(topicsBank[0].cards));
        let userState = {};
        let selectedCardId = null;

        window.onload = function() {
            populateTopicDropdown();
            loadTopic(currentTopicId);
        };

        function populateTopicDropdown() {
            const selector = document.getElementById('topic-selector');
            selector.innerHTML = '';
            topicsBank.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.id;
                opt.textContent = `${t.elective}: ${t.title}`;
                selector.appendChild(opt);
            });
        }

        function switchTopic(topicId) {
            loadTopic(topicId);
        }

        function loadRandomTopic() {
            const otherTopics = topicsBank.filter(t => t.id !== currentTopicId);
            const random = otherTopics[Math.floor(Math.random() * otherTopics.length)] || topicsBank[0];
            document.getElementById('topic-selector').value = random.id;
            loadTopic(random.id);
            showToast(`Loaded new DSE Topic: ${random.title}`, "fa-dice");
        }

        function loadTopic(topicId) {
            const topic = topicsBank.find(t => t.id === topicId) || topicsBank[0];
            currentTopicId = topic.id;
            cardsData = JSON.parse(JSON.stringify(topic.cards));

            // Update UI Banner
            document.getElementById('prompt-tag').textContent = topic.tag || "HKDSE Part B Task";
            document.getElementById('prompt-format').innerHTML = `<i class="fa-solid fa-file-pen text-indigo-400 mr-1.5"></i>${topic.format}`;
            document.getElementById('prompt-elective').textContent = topic.elective;
            document.getElementById('prompt-words').innerHTML = `<i class="fa-solid fa-clock text-amber-400 mr-1"></i>${topic.words}`;
            document.getElementById('prompt-title').textContent = topic.title;
            document.getElementById('prompt-desc').innerHTML = topic.desc;

            initApp();
        }

        function initApp() {
            userState = {};
            cardsData.forEach(card => {
                userState[card.id] = {
                    userSection: null,
                    userHierarchy: null
                };
            });
            selectedCardId = null;
            renderPool();
            renderZones();
            updateStats();
            if (!document.getElementById('diagram-view').classList.contains('hidden')) {
                renderDiagram();
            }
        }

        function renderPool() {
            const poolEl = document.getElementById('pool-container');
            poolEl.innerHTML = '';

            const unplacedCards = cardsData.filter(card => userState[card.id].userSection === null);

            if (unplacedCards.length === 0) {
                poolEl.innerHTML = `
                    <div class="p-6 text-center text-slate-400 text-xs border border-dashed rounded-xl my-auto">
                        <i class="fa-solid fa-circle-check text-emerald-500 text-2xl mb-2 block"></i>
                        All cards have been placed!
                    </div>
                `;
                return;
            }

            unplacedCards.forEach((card, index) => {
                const cardEl = document.createElement('div');
                const isSelected = (selectedCardId === card.id);

                cardEl.className = `p-3 rounded-xl border text-xs cursor-pointer transition-all ${
                    isSelected 
                        ? 'border-indigo-600 bg-indigo-50/80 shadow-md ring-2 ring-indigo-500 scale-[1.02]' 
                        : 'border-slate-200 bg-white hover:border-indigo-300 hover:shadow-sm'
                }`;

                cardEl.onclick = (e) => selectCard(card.id, e);

                cardEl.innerHTML = `
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-[10px] font-bold text-slate-400 uppercase">Card #${card.id.split('-')[1] || (index+1)}</span>
                        ${isSelected ? '<span class="text-[10px] bg-indigo-600 text-white font-bold px-1.5 py-0.5 rounded">Selected</span>' : ''}
                    </div>
                    <p class="text-slate-800 font-medium leading-snug">${card.text}</p>
                `;

                poolEl.appendChild(cardEl);
            });
        }

        function renderZones() {
            ['part1', 'part2', 'part3'].forEach(secKey => {
                const zoneEl = document.getElementById(`zone-${secKey}`);
                zoneEl.innerHTML = '';

                const placedCards = cardsData.filter(card => userState[card.id].userSection === secKey);

                if (placedCards.length === 0) {
                    zoneEl.innerHTML = `
                        <div class="h-full flex items-center justify-center text-center text-slate-400 text-xs border-2 border-dashed border-slate-200 rounded-xl p-4">
                            Click a selected card to place it here
                        </div>
                    `;
                    return;
                }

                placedCards.forEach(card => {
                    const cardEl = document.createElement('div');
                    const hier = userState[card.id].userHierarchy;

                    let hierClass = "border-slate-200 bg-white";
                    if (hier === 'umbrella') hierClass = "border-amber-400 bg-amber-50/60";
                    if (hier === 'detail') hierClass = "border-emerald-400 bg-emerald-50/60";

                    cardEl.className = `p-3 rounded-xl border text-xs space-y-2 shadow-xs transition ${hierClass}`;

                    cardEl.innerHTML = `
                        <div class="flex items-start justify-between gap-2">
                            <p class="text-slate-800 font-medium leading-snug flex-1">${card.text}</p>
                            <button onclick="returnToPool('${card.id}', event)" title="Return to pool" class="text-slate-400 hover:text-red-500 p-1">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                            </button>
                        </div>
                        <div class="flex items-center gap-1.5 pt-1 border-t border-slate-100">
                            <span class="text-[10px] font-bold text-slate-400 mr-1">Tag:</span>
                            <button onclick="setHierarchy('${card.id}', 'umbrella', event)" class="px-2 py-0.5 text-[10px] font-bold rounded-md transition ${
                                hier === 'umbrella' 
                                    ? 'bg-amber-500 text-white shadow-xs' 
                                    : 'bg-slate-100 text-slate-600 hover:bg-amber-100 hover:text-amber-800'
                            }">
                                🟠 Umbrella
                            </button>
                            <button onclick="setHierarchy('${card.id}', 'detail', event)" class="px-2 py-0.5 text-[10px] font-bold rounded-md transition ${
                                hier === 'detail' 
                                    ? 'bg-emerald-600 text-white shadow-xs' 
                                    : 'bg-slate-100 text-slate-600 hover:bg-emerald-100 hover:text-emerald-800'
                            }">
                                🔴 Detail
                            </button>
                        </div>
                    `;

                    zoneEl.appendChild(cardEl);
                });
            });
        }

        function selectCard(cardId, e) {
            if (e) e.stopPropagation();
            if (selectedCardId === cardId) {
                selectedCardId = null;
            } else {
                selectedCardId = cardId;
            }
            renderPool();
        }

        function handleZoneClick(secKey) {
            if (!selectedCardId) return;
            userState[selectedCardId].userSection = secKey;
            selectedCardId = null;
            renderPool();
            renderZones();
            updateStats();
            if (!document.getElementById('diagram-view').classList.contains('hidden')) {
                renderDiagram();
            }
        }

        function setHierarchy(cardId, hierType, e) {
            if (e) e.stopPropagation();
            if (userState[cardId].userHierarchy === hierType) {
                userState[cardId].userHierarchy = null;
            } else {
                userState[cardId].userHierarchy = hierType;
            }
            renderZones();
            updateStats();
            if (!document.getElementById('diagram-view').classList.contains('hidden')) {
                renderDiagram();
            }
        }

        function returnToPool(cardId, e) {
            if (e) e.stopPropagation();
            userState[cardId].userSection = null;
            userState[cardId].userHierarchy = null;
            if (selectedCardId === cardId) selectedCardId = null;
            renderPool();
            renderZones();
            updateStats();
            if (!document.getElementById('diagram-view').classList.contains('hidden')) {
                renderDiagram();
            }
        }

        function updateStats() {
            const total = cardsData.length;
            let placed = 0;
            let tagged = 0;

            let p1Count = 0, p2Count = 0, p3Count = 0;

            cardsData.forEach(c => {
                const st = userState[c.id];
                if (st.userSection) {
                    placed++;
                    if (st.userSection === 'part1') p1Count++;
                    if (st.userSection === 'part2') p2Count++;
                    if (st.userSection === 'part3') p3Count++;
                }
                if (st.userHierarchy) tagged++;
            });

            document.getElementById('stat-placed').textContent = `${placed} / ${total}`;
            document.getElementById('stat-hierarchy').textContent = `${tagged} / ${total}`;

            document.getElementById('p1-badge').textContent = `${p1Count} cards`;
            document.getElementById('p2-badge').textContent = `${p2Count} cards`;
            document.getElementById('p3-badge').textContent = `${p3Count} cards`;

            const poolCount = total - placed;
            document.getElementById('pool-count-badge').textContent = `${poolCount} Left`;
        }

        function toggleView() {
            const classView = document.getElementById('classification-view');
            const diagView = document.getElementById('diagram-view');
            const toggleBtnText = document.getElementById('view-toggle-text');

            if (classView.classList.contains('hidden')) {
                classView.classList.remove('hidden');
                diagView.classList.add('hidden');
                toggleBtnText.textContent = "Diagram Mindmap View";
            } else {
                classView.classList.add('hidden');
                diagView.classList.remove('hidden');
                toggleBtnText.textContent = "Card Sorting View";
                renderDiagram();
            }
        }

        function renderDiagram() {
            const canvas = document.getElementById('diagram-canvas');
            canvas.innerHTML = '';

            const currentTopic = topicsBank.find(t => t.id === currentTopicId) || topicsBank[0];

            // Center Topic Hub
