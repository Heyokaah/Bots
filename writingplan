        function saveCustomizations() {
            cardsData.forEach(card => {
                const textVal = document.getElementById(`cust-text-${card.id}`).value;
                const secVal = document.getElementById(`cust-sec-${card.id}`).value;
                const hierVal = document.getElementById(`cust-hier-${card.id}`).value;

                card.text = textVal;
                card.section = secVal;
                card.hierarchy = hierVal;
            });

            closeModal('modal-customizer');
            initApp();
            showToast("Custom prompt & cards saved successfully!", "fa-floppy-disk");
