            centerNode.innerHTML = `
                <div class="text-[10px] text-amber-400 uppercase tracking-widest font-extrabold mb-0.5">Essay Topic Blueprint</div>
                <div class="text-sm font-bold"><i class="fa-solid fa-pen-nib text-indigo-400 mr-2"></i>${currentTopic.format}: ${currentTopic.title}</div>
            `;

            const sectionsRow = document.createElement('div');
            sectionsRow.className = "grid grid-cols-1 md:grid-cols-3 gap-6 w-full";

            ['part1', 'part2', 'part3'].forEach((secKey) => {
                const secCol = document.createElement('div');
                secCol.className = "bg-slate-50 rounded-2xl p-4 border border-slate-200 flex flex-col gap-3 min-h-[400px]";

                const titleMap = {
                    part1: "PART 1: Current Problem / Context",
                    part2: "PART 2: Immediate Ways & Actions",
                    part3: "PART 3: Long-term Systemic Solutions"
                };

                secCol.innerHTML = `<div class="bg-indigo-950 text-white text-xs font-bold p-2.5 rounded-xl text-center shadow">${titleMap[secKey]}</div>`;

                const placedInSec = cardsData.filter(c => userState[c.id].userSection === secKey);

                if (placedInSec.length === 0) {
                    secCol.innerHTML += `<div class="text-center text-slate-400 text-xs py-12 border border-dashed rounded-xl">No cards assigned to this section yet.</div>`;
                } else {
                    const umbrellas = placedInSec.filter(c => userState[c.id].userHierarchy === 'umbrella');
                    const orphanDetails = placedInSec.filter(c => userState[c.id].userHierarchy === 'detail' && (!c.parentId || !placedInSec.some(u => u.id === c.parentId && userState[u.id].userHierarchy === 'umbrella')));
                    const untagged = placedInSec.filter(c => !userState[c.id].userHierarchy);

                    umbrellas.forEach(u => {
                        const uGroup = document.createElement('div');
                        uGroup.className = "bg-amber-50/90 border-2 border-amber-400 rounded-xl p-3 space-y-2.5 shadow-sm";
                        
                        const attachedDetails = placedInSec.filter(c => c.parentId === u.id && userState[c.id].userHierarchy === 'detail');

                        let detailsHtml = '';
                        if (attachedDetails.length > 0) {
                            detailsHtml = attachedDetails.map(d => `
                                <div class="bg-emerald-50 border border-emerald-300 p-2 rounded-lg text-xs text-slate-800 flex items-start gap-2 shadow-xs">
                                    <span class="text-emerald-600 font-extrabold text-sm leading-none mt-0.5">↳</span>
                                    <div class="flex-1">
                                        <span class="text-[9px] font-bold text-emerald-800 uppercase block mb-0.5">Supporting Detail</span>
                                        <span>${d.text}</span>
                                    </div>
                                </div>
                            `).join('');
                        } else {
                            detailsHtml = `<div class="text-[11px] text-amber-700/70 italic p-1.5 border border-dashed border-amber-300 rounded">No supporting details linked under this umbrella yet.</div>`;
                        }

                        uGroup.innerHTML = `
                            <div class="flex items-center justify-between border-b border-amber-200 pb-1.5">
                                <span class="bg-amber-500 text-white text-[9px] font-extrabold px-2 py-0.5 rounded-md uppercase tracking-wider flex items-center gap-1">
                                    🟠 Umbrella Topic Sentence
                                </span>
                            </div>
                            <p class="text-xs text-slate-900 font-semibold leading-relaxed">${u.text}</p>
                            <div class="pl-2 border-l-2 border-amber-400 space-y-2 pt-1">
                                ${detailsHtml}
                            </div>
                        `;
                        secCol.appendChild(uGroup);
                    });

                    if (orphanDetails.length > 0) {
                        const orphanBox = document.createElement('div');
                        orphanBox.className = "bg-emerald-50/50 border border-emerald-200 rounded-xl p-2.5 space-y-2";
                        orphanBox.innerHTML = `<div class="text-[10px] font-bold text-emerald-800 uppercase">Unlinked Supporting Details:</div>`;
                        orphanDetails.forEach(d => {
                            orphanBox.innerHTML += `
                                <div class="bg-emerald-50 border border-emerald-300 p-2 rounded-lg text-xs text-slate-700 flex items-start gap-1.5">
                                    <span class="text-emerald-600 font-bold">🔴</span>
                                    <span>${d.text}</span>
                                </div>
                            `;
                        });
                        secCol.appendChild(orphanBox);
                    }

                    if (untagged.length > 0) {
                        const unContainer = document.createElement('div');
                        unContainer.className = "space-y-1.5 pt-2 border-t border-slate-200 opacity-75";
                        unContainer.innerHTML = `<div class="text-[10px] font-bold text-slate-500 uppercase">Untagged Cards:</div>`;
                        untagged.forEach(un => {
                            unContainer.innerHTML += `<div class="bg-white border border-slate-300 p-2 rounded-lg text-xs text-slate-600">${un.text}</div>`;
                        });
                        secCol.appendChild(unContainer);
                    }
                }

                sectionsRow.appendChild(secCol);
            });

            canvas.appendChild(centerNode);
            canvas.appendChild(sectionsRow);
        }

        function checkAnswers() {
            let sectionCorrect = 0;
            let hierarchyCorrect = 0;
            const total = cardsData.length;

            cardsData.forEach(card => {
                const st = userState[card.id];
                if (st.userSection === card.section) sectionCorrect++;
                if (st.userHierarchy === card.hierarchy) hierarchyCorrect++;
            });

            document.getElementById('score-section').textContent = `${sectionCorrect} / ${total} Correct`;
            document.getElementById('score-hierarchy').textContent = `${hierarchyCorrect} / ${total} Correct`;

            const feedbackEl = document.getElementById('feedback-details');
            if (sectionCorrect === total && hierarchyCorrect === total) {
                feedbackEl.className = "p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 leading-relaxed";
                feedbackEl.innerHTML = `<b>🎉 Perfect Blueprint!</b> You successfully classified all 3 sections and correctly identified every Topic Sentence (Umbrella Point) vs Supporting Detail.`;
            } else {
                feedbackEl.className = "p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 leading-relaxed";
                feedbackEl.innerHTML = `<b>💡 Almost there!</b> Umbrella points are general summary statements (Topic Sentences), while supporting details give specific examples or actions.`;
            }

            document.getElementById('modal-results').classList.remove('hidden');
        }

        function revealModelSolution() {
            cardsData.forEach(card => {
                userState[card.id].userSection = card.section;
                userState[card.id].userHierarchy = card.hierarchy;
            });
            closeModal('modal-results');
            renderPool();
            renderZones();
            updateStats();
            showToast("Updated to Ideal DSE Blueprint Model Solution!", "fa-circle-check");
        }

